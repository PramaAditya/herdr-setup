                      "header": {
                        "content": {
                          "mod": "pane"
                        },
                        "reveal": "always",
                        "height": 30,
                        "position": "top"
                      },
                      "background": "background",
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "focus": {
                        "width": 1,
                        "color": "accent"
                      },
                      "radius": 10,
                      "gap": 8,
                      "lone": true
                    }
                  }
                },
                {
                  "id": "customize-drawer",
                  "type": "column",
                  "children": [
                    {
                      "id": "customize-drawer-header",
                      "type": "block",
                      "content": {
                        "mod": "customize-drawer"
                      },
                      "size": {
                        "px": 34
                      }
                    },
                    {
                      "id": "customize-drawer-body",
                      "type": "row",
                      "children": [
                        {
                          "id": "customize-drawer-term",
                          "type": "block",
                          "content": {
                            "terminal": "t1g"
                          },
                          "size": {
                            "weight": 1
                          }
                        },
                        {
                          "id": "customize-drawer-files",
                          "type": "block",
                          "content": {
                            "mod": "files",
                            "props": {
                              "drawer": true
                            }
                          },
                          "size": {
                            "px": 280
                          },
                          "min": 200,
                          "max": 500,
                          "hidden": true
                        }
                      ],
                      "gap": 8
                    }
                  ],
                  "size": {
                    "px": 320
                  },
                  "min": 180,
                  "max": 700
                }
              ],
              "gap": 8
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "todoist",
                      "type": "block",
                      "content": {
                        "mod": "todoist"
                      }
                    },
                    {
                      "id": "kanban",
                      "type": "block",
                      "content": {
                        "mod": "kanban"
                      }
                    },
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 473
              },
              "min": 280,
              "max": 900
            }
          ],
          "padding": 8,
          "gap": 8
